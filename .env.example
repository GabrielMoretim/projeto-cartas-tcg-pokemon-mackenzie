# Copie para .env (NUNCA commite o .env). A senha está na página do projeto.
S3_ENDPOINT=https://lake-aulas-mackenzie.afonsolelis.tech
S3_ACCESS_KEY=turma-mackenzie
S3_SECRET_KEY=<senha da turma>
S3_REGION=us-east-1
S3_BUCKET=tcg

# Sua coleção (veja a tabela no README) e seu nome
GROUP_ID=24269
RESPONSAVEL=Seu Nome

# Taxa de venda do marketplace usada no desafio (hipótese do ADR 0004)
TAXA_VENDA=0.15

# s3 (padrão) ou local (grava em ./data/lake, útil para desenvolver sem tocar o lake)
STORE=s3
